<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gajeroll.capsawake.daemon</string>
  <!-- What Login Items & Extensions names this entry after. Without it the user is
       asked to approve a bare label rather than "CapsAwake". -->
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.gajeroll.capsawake</string>
  </array>
  <!-- Relative to the app bundle. An absolute ProgramArguments path would only
       resolve for one install location, and SMAppService prefers BundleProgram. -->
  <key>BundleProgram</key>
  <string>Contents/MacOS/CapsAwakeDaemon</string>
  <!-- Demand-launched by the XPC connection. RunAtLoad and KeepAlive would keep a
       root process alive for the whole session with nothing to do. -->
  <key>MachServices</key>
  <dict>
    <key>com.gajeroll.capsawake.daemon</key>
    <true/>
  </dict>
</dict>
</plist>
