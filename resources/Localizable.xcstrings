      }
    },
    "awake_past_sleep_time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On system sleep timer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムスリープタイマー経過時"
          }
        }
      }
    },
    "awake_past_sleep_time_always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay awake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープを抑止"
          }
        }
      }
    },
    "awake_past_sleep_time_lid_closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay awake only while lid is closed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じているときのみスリープを抑止"
          }
        }
      }
    },
    "awake_past_sleep_time_never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Mac to sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのスリープを許可"
          }
        }
      }
    },
    "awake_past_sleep_time_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System sleep time is configured in System Settings, measured from the last user input. Staying awake only while the lid is closed keeps a closed Mac running, while allowing an idle open Mac to sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのスリープ時間はシステム設定で管理され、最後のユーザー操作から計測されます。「蓋を閉じているときのみ」を選択すると、閉じたMacでの処理を継続しながら、開いたまま放置されたMacはスリープさせることができます。"
          }
        }
      }
    },
    "awake_sleep_time_now %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current system setting: %lld minutes of inactivity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のシステム設定: 無操作状態が%lld分続くとスリープします。"
          }
        }
      }
    },
    "awake_sleep_time_never": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is currently configured in System Settings to never sleep automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacは現在、自動スリープしないようにシステム設定で構成されています。"
          }
        }
      }
    },
    "awake_battery_floor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum battery level"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最低バッテリー残量"
          }
        }
      }
    },
    "awake_battery_floor_any": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No minimum"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限なし"
          }
        }
      }
    },
    "awake_battery_floor_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only when running on battery. When the battery reaches this level, CapsAwake turns off automatically and displays a notification. This prevents completely draining the battery and allows normal sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー駆動時のみ適用されます。バッテリーがこの残量に達すると、CapsAwakeは自動的にオフになり通知を表示します。バッテリーの完全放電を防ぎ、通常のスリープに移行します。"
          }
        }
      }
    },
    "awake_thermal_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thermal protection cannot be disabled. CapsAwake turns off sleep prevention if the system reaches a critical temperature, or reaches a serious temperature with the lid closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度管理による保護は無効にできません。システムが重大な高温に達した場合、または蓋を閉じた状態で高温に達した場合、CapsAwakeは自動的にスリープ抑止を解除します。"
          }
        }
      }
    },
    "notification_sleep_time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwake turned off sleep prevention because the system idle sleep timer expired."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無操作のままシステムスリープタイマーが経過したため、CapsAwakeはスリープ抑止をオフにしました。"
          }
        }
      }
    },
    "settings_section_attention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action Required"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要対応"
          }
        }
      }
    },
    "settings_section_attention_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details and purposes for each permission are listed in the Permissions section below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各権限の詳細と使用目的は、下の「権限」セクションに記載されています。"
          }
        }
      }
    },
    "settings_section_permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限"
          }
        }
      }
    },
    "settings_section_permissions_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwake only requests permissions required for its features. Each entry describes its purpose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwakeは機能の実行に必要な権限のみを要求します。各項目の用途は下記のとおりです。"
          }
        }
      }
    },
    "show_menu_bar_icon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show menu bar icon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーにアイコンを表示"
          }
        }
      }
    },
    "status_accessibility_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ権限が必要です"
          }
        }
      }
    },
    "status_daemon_approval_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background daemon requires approval"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドデーモンの承認が必要です"
          }
        }
      }
    },
    "status_privileged_error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change sleep settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ設定を変更できません"
          }
        }
      }
    },
    "tooltip_active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock ON — Sleep prevention active"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock ON — スリープ抑止中"
          }
        }
      }
    },
    "tooltip_active_caps_typing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep prevention active — Capital typing on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ抑止中 — 大文字入力オン"
          }
        }
      }
    },
    "tooltip_caps_typing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capital typing on — Sleep prevention off"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字入力オン — スリープ抑止オフ"
          }
        }
      }
    },
    "tooltip_daemon_approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve the background daemon in Login Items to control sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープを制御するには「ログイン項目」でデーモンを承認してください"
          }
        }
      }
    },
    "tooltip_dedicated_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility permission required to separate Caps Lock from capital typing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockと大文字入力を分離するにはアクセシビリティ権限が必要です"
          }
        }
      }
    },
    "tooltip_idle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock OFF — Normal sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock OFF — 通常のスリープ"
          }
        }
      }
    },
    "tooltip_privileged_error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update sleep settings — Retrying"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ設定を更新できません — 再試行中"
          }
        }
      }
    },
    "remove_caps_lock_delay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Caps Lock key delay"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockキーの遅延を無効にする"
          }
        }
      }
    },
    "remove_caps_lock_delay_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ignores Caps Lock presses shorter than about 75 ms. Fast taps may not reach CapsAwake while this delay is active. CapsAwake disables the keyboard delay while running and restores it on quit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは約75ミリ秒未満のCaps Lockキー押下を無視します。この遅延が有効な場合、キーを素早くタップしてもCapsAwakeに反応しないことがあります。CapsAwakeの起動中にこの遅延を無効化し、終了時に元の設定に戻します。"
          }
        }
      }
    },
    "capitals_shortcut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut for capitals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字入力のショートカット"
          }
        }
      }
    },
    "capitals_shortcut_none_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a shortcut, Caps Lock only toggles CapsAwake. Capital typing can be toggled from the menu bar or Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを設定しない場合、Caps LockキーはCapsAwakeの切り替えのみを行います。大文字入力はメニューバーまたは設定から切り替えることができます。"
          }
        }
      }
    },
    "capitals_shortcut_set_help %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ to toggle typing in capitals. Pressing Caps Lock alone toggles CapsAwake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を押して大文字入力を切り替えます。Caps Lock単体を押すとCapsAwakeが切り替わります。"
          }
        }
      }
    },
    "dedicated_mode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedicate Caps Lock to CapsAwake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps LockをCapsAwake専用にする"
          }
        }
      }
    },
    "dedicated_mode_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Caps Lock toggles sleep prevention without typing in capital letters. This option requires Accessibility permission. Capital typing can then be toggled separately using a shortcut or the menu bar. When disabled, Caps Lock functions normally and toggles sleep prevention at the same time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Caps Lockキーは大文字を入力せずにスリープ抑止のみを切り替えます。この機能にはアクセシビリティ権限が必要です。大文字入力はショートカットやメニューバーから個別に切り替えることができます。無効時は、通常のCaps Lock動作とスリープ抑止が同時に切り替わります。"
          }
        }
      }
    },
    "capitals_shortcut_listening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press keys…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを入力…"
          }
        }
      }
    },
    "capitals_shortcut_none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "capitals_shortcut_clear": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear shortcut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを消去"
          }
        }
      }
    },
    "capitals_shortcut_record_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the next key combination pressed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に押されたキーの組み合わせを登録します。"
          }
        }
      }
    },
    "capitals_shortcut_listening_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the desired modifier keys and press Caps Lock. Caps Lock alone cannot be used because it is reserved for CapsAwake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定したい修飾キーを押しながらCaps Lockを押してください。Caps Lock単体はCapsAwake用に予約されているため、ショートカットとしては使用できません。"
          }
        }
      }
    },
    "shift_types_small_letters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift types lowercase while in capitals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字固定中にShiftで小文字を入力"
          }
        }
      }
    },
    "shift_types_small_letters_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS standard behavior produces uppercase letters when pressing Shift while Caps Lock is on. Enabling this option follows Windows behavior, typing lowercase letters while holding Shift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSの標準動作では、Caps LockがオンのときにShiftキーを押しても大文字が入力されます。このオプションを有効にすると、WindowsのようにShiftキーを押している間は小文字が入力されます。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
