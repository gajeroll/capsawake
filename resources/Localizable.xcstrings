          }
        }
      }
    },
    "all_caps_typing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock to capitals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字入力に固定"
          }
        }
      }
    },
    "capsawake_toggle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable CapsAwake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwakeを有効にする"
          }
        }
      }
    },
    "capsawake_toggle_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing the Caps Lock key also toggles this setting. The key LED indicates when sleep prevention is active."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockキーを押しても切り替わります。有効時はキーボードのLEDが点灯します。"
          }
        }
      }
    },
    "change_energy_mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch Energy Mode when active"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効時にエネルギーモードを切り替える"
          }
        }
      }
    },
    "display_sleep_on_lid_close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off display when lid closes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じたときに画面をオフにする"
          }
        }
      }
    },
    "energy_mode": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モード"
          }
        }
      }
    },
    "energy_mode_adapter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On power adapter"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源アダプタ使用時"
          }
        }
      }
    },
    "energy_mode_automatic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動"
          }
        }
      }
    },
    "energy_mode_battery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On battery"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー使用時"
          }
        }
      }
    },
    "energy_mode_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous energy mode is restored when CapsAwake turns off. High Power increases heat and power draw. This is not recommended while keeping a closed Mac awake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwakeをオフにすると、元のエネルギーモードに戻ります。高パフォーマンスは発熱と消費電力が増加するため、Macを閉じた状態で使い続ける用途には推奨されません。"
          }
        }
      }
    },
    "energy_mode_high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High Power (not recommended)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高パフォーマンス（非推奨）"
          }
        }
      }
    },
    "energy_mode_low": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low Power"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力"
          }
        }
      }
    },
    "energy_mode_section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Energy Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エネルギーモード"
          }
        }
      }
    },
    "get_started": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始める"
          }
        }
      }
    },
    "language": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        }
      }
    },
    "launch_at_login": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at login"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン時に開く"
          }
        }
      }
    },
    "lid_close_may_sleep_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the lid may still put this Mac to sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じるとMacがスリープする可能性があります"
          }
        }
      }
    },
    "notification_accessibility": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwake requires Accessibility permission to separate Caps Lock from capital typing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockキーと大文字入力を分離するには、アクセシビリティ権限が必要です。"
          }
        }
      }
    },
    "notification_battery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwake turned off sleep prevention because the battery is low."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー残量が低下したため、CapsAwakeはスリープ抑止をオフにしました。"
          }
        }
      }
    },
    "notification_daemon_approval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve the background daemon in Login Items & Extensions to manage sleep settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリープ設定を管理するには、「ログイン項目と拡張機能」でバックグラウンドデーモンを承認してください。"
          }
        }
      }
    },
    "notification_display_sleep_blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not turn off the display while the lid is closed. Another app may be keeping it awake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蓋を閉じた状態で画面をオフにできませんでした。ほかのアプリケーションが画面の起動を維持している可能性があります。"
          }
        }
      }
    },
    "notification_thermal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwake turned off sleep prevention because the system is overheating."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが高温になったため、CapsAwakeはスリープ抑止をオフにしました。"
          }
        }
      }
    },
    "onboarding_back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻る"
          }
        }
      }
    },
    "onboarding_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Caps Lock on to keep your Mac awake while working with the lid closed. Turn it off to restore normal sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockをオンにすると、蓋を閉じた状態でもMacのスリープを抑止して作業を継続できます。オフにすると通常のスリープ動作に戻ります。"
          }
        }
      }
    },
    "onboarding_capitals_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lock always toggles CapsAwake. Choose whether pressing the key also types in capital letters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockキーは常にCapsAwakeの切り替えに使用されます。キーを押した際に大文字入力も行うかどうかを選択してください。"
          }
        }
      }
    },
    "onboarding_continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続ける"
          }
        }
      }
    },
    "onboarding_daemon_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue without approving now and do so later in Settings. Sleep prevention will not work until approved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認せずに進めて、後から設定画面で承認することもできます。ただし、承認されるまでスリープ抑止は動作しません。"
          }
        }
      }
    },
    "onboarding_permissions_intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next steps configure the permissions CapsAwake requires from macOS. Both can be changed later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のステップで、CapsAwakeに必要なmacOSの権限を設定します。いずれの権限も後から設定画面で変更できます。"
          }
        }
      }
    },
    "onboarding_preferences_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional options can be configured at any time in Settings from the menu bar icon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その他のオプションは、メニューバーアイコンからいつでも設定画面を開いて変更できます。"
          }
        }
      }
    },
    "onboarding_step %lld %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step %1$lld of %2$lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ %1$lld / %2$lld"
          }
        }
      }
    },
    "onboarding_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to CapsAwake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwakeへようこそ"
          }
        }
      }
    },
