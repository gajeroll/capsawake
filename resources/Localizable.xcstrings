        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン項目の設定を開く…"
          }
        }
      }
    },
    "open_settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        }
      }
    },
    "quit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit CapsAwake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwakeを終了"
          }
        }
      }
    },
    "restart": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart CapsAwake"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CapsAwakeを再起動"
          }
        }
      }
    },
    "restart_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart CapsAwake to apply updated system permissions or code signatures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム権限やコード署名の変更を適用するには、CapsAwakeを再起動してください。"
          }
        }
      }
    },
    "separate_energy_modes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set battery and power adapter separately"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーと電源アダプタを個別に設定"
          }
        }
      }
    },
