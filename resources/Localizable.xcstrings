{
  "sourceLanguage": "en",
  "strings": {
    "access_accessibility_impact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until allowed, dedicating Caps Lock to CapsAwake has no effect. CapsAwake stays off to prevent typing in capitals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されるまで「Caps LockをCapsAwake専用にする」は機能しません。意図しない大文字入力を防ぐため、CapsAwakeはオフのままになります。"
          }
        }
      }
    },
    "access_accessibility_not_needed_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not needed while Caps Lock functions normally. CapsAwake reads the hardware lock state instead of key events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps Lockを通常の動作で使用している間は不要です。CapsAwakeはキーイベントではなく、ハードウェアのロック状態を直接読み取ります。"
          }
        }
      }
    },
    "access_accessibility_purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows Caps Lock to toggle sleep prevention without typing in capitals. Keystrokes are never stored or transmitted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字を入力せずに、Caps Lockキーでスリープ抑止を切り替えられるようにします。キー入力の記録や送信は一切行いません。"
          }
        }
      }
    },
    "access_accessibility_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "access_daemon_impact_awaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until approved, system sleep settings cannot be changed. Your Mac will still sleep normally even if CapsAwake is turned on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認されるまでスリープ設定を変更できません。CapsAwakeをオンにしても、Macは通常どおりスリープします。"
          }
        }
      }
    },
    "access_daemon_impact_failing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sleep setting cannot be changed right now, so your Mac may sleep. CapsAwake continues to retry. If the problem persists, approve the daemon again in Login Items or restart CapsAwake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在スリープ設定を変更できないため、Macがスリープする可能性があります。CapsAwakeは再試行を続けています。解消しない場合は「ログイン項目」でデーモンを再度承認するか、CapsAwakeを再起動してください。"
          }
        }
      }
    },
    "access_daemon_purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifies system sleep settings. This operation requires root privileges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのスリープ設定を変更します。この操作にはroot権限が必要です。"
          }
        }
      }
    },
    "access_daemon_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Daemon"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドデーモン"
          }
        }
      }
    },
    "access_status_awaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ち"
          }
        }
      }
    },
    "access_status_failing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not working"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動作していません"
          }
        }
      }
    },
    "access_status_granted": {
      "extractionState": "manual",
      "localizations": {
